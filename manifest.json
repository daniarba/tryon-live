{
  "manifest_version": 3,
  "name": "TryOn Live: Real-Time Virtual Try-On",
  "version": "1.2.0",
  "description": "Try on any garment live from your webcam. Right-click any garment photo on any site to try it. AI body tracking + segmentation compositing. Free, offline.",
  "action": {
    "default_title": "Open Virtual Try-On"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}